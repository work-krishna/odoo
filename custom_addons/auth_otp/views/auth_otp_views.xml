<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auth_otp_view_list" model="ir.ui.view">
        <field name="name">auth.otp.view.list</field>
        <field name="model">auth.otp</field>
        <field name="arch" type="xml">
            <list string="One-Time Codes" create="0" edit="0" delete="0">
                <field name="sent_at" string="Sent"/>
                <field name="purpose"/>
                <field name="user_id" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="channels"/>
                <field name="state" decoration-success="state == 'verified'" decoration-danger="state in ('blocked', 'failed')"/>
                <field name="verified_by" string="Code Used"/>
                <field name="attempts"/>
                <field name="ip_address" optional="hide"/>
                <field name="failure_reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="auth_otp_view_search" model="ir.ui.view">
        <field name="name">auth.otp.view.search</field>
        <field name="model">auth.otp</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="phone"/>
                <field name="user_id"/>
                <filter name="failed" string="Not Sent" domain="[('state', '=', 'failed')]"/>
                <filter name="blocked" string="Too Many Wrong Codes" domain="[('state', '=', 'blocked')]"/>
                <group>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="auth_otp_action" model="ir.actions.act_window">
        <field name="name">One-Time Codes</field>
        <field name="res_model">auth.otp</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No code sent yet</p>
            <p>Codes for sign-up, login, checkout and EMI applications appear here. The codes themselves are never stored, only a keyed hash.</p>
        </field>
    </record>

    <menuitem id="auth_otp_menu" action="auth_otp_action" parent="base.menu_security" sequence="40" groups="base.group_system"/>
</odoo>
