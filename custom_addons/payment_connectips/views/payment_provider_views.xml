<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_connectips" model="ir.ui.view">
        <field name="name">connectIPS Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'connectips'">
                    <field name="connectips_merchant_id" required="code == 'connectips' and state != 'disabled'"/>
                    <field name="connectips_app_id" required="code == 'connectips' and state != 'disabled'"/>
                    <field name="connectips_app_name" required="code == 'connectips' and state != 'disabled'"/>
                    <field name="connectips_password" password="True"
                           required="code == 'connectips' and state != 'disabled'"/>
                    <field name="connectips_certificate" required="code == 'connectips' and state != 'disabled'"/>
                    <field name="connectips_certificate_password" password="True"/>
                    <field name="connectips_test_base_url"/>
                    <field name="connectips_live_base_url"/>
                    <field name="connectips_success_url" string="Success URL to register with NCHL" readonly="1"/>
                    <field name="connectips_failure_url" string="Failure URL to register with NCHL" readonly="1"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
