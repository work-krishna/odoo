<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Which variants have their own image -->
    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.variant.image</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_template_variant_value_ids" position="after">
                <field
                    name="image_variant_128"
                    string="Variant Image"
                    widget="image"
                    options="{'size': [32, 32], 'img_class': 'object-fit-contain'}"
                    optional="show"
                    readonly="1"
                />
            </field>
        </field>
    </record>
</odoo>
