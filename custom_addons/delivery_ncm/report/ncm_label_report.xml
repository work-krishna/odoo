<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_ncm_label" model="report.paperformat">
        <field name="name">NCM Label 100 x 150 mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_ncm_label" model="ir.actions.report">
        <field name="name">NCM Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">delivery_ncm.report_ncm_label</field>
        <field name="report_file">delivery_ncm.report_ncm_label</field>
        <field name="print_report_name">'NCM-%s' % (object.ncm_order_id or object.name)</field>
        <field name="paperformat_id" ref="paperformat_ncm_label"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_ncm_label_document">
        <t t-call="web.basic_layout">
            <t t-set="carrier" t-value="o.carrier_id"/>
            <t t-set="partner" t-value="o._ncm_customer()"/>
            <t t-set="from_branch" t-value="o.ncm_from_branch_id or carrier.ncm_from_branch_id"/>
            <t t-set="to_branch" t-value="o.ncm_dest_branch_id"/>
            <t t-set="collect" t-value="carrier.ncm_delivery_type in ('Door2Branch', 'Branch2Branch')"/>
            <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; line-height: 1.25;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="font-size: 15px; font-weight: bold;">Nepal Can Move</td>
                        <td style="text-align: right; font-size: 18px; font-weight: bold;">
                            #<t t-out="o.ncm_order_id or ''"/>
                        </td>
                    </tr>
                </table>
                <div t-if="o.ncm_order_id" style="text-align: center; margin: 2mm 0;">
                    <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=120&amp;humanreadable=1' % o.ncm_order_id"
                         style="width: 88mm; height: 20mm;" alt="NCM order barcode"/>
                </div>
                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                    <tr>
                        <td style="width: 50%; border: 1px solid #000; padding: 1mm;">
                            <div style="font-size: 9px;">FROM BRANCH</div>
                            <div style="font-size: 13px; font-weight: bold;" t-out="from_branch.name or ''"/>
                            <div t-out="' · '.join(filter(None, [from_branch.code or '', (from_branch.district or '').title()]))"/>
                        </td>
                        <td style="width: 50%; border: 1px solid #000; padding: 1mm;">
                            <div style="font-size: 9px;">TO BRANCH</div>
                            <div style="font-size: 13px; font-weight: bold;" t-out="to_branch.name or ''"/>
                            <div t-out="' · '.join(filter(None, [to_branch.code or '', (to_branch.district or '').title()]))"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="border: 1px solid #000; padding: 1mm; text-align: center; font-weight: bold;">
                            <t t-if="collect">CUSTOMER COLLECTS AT BRANCH</t>
                            <t t-else="">HOME DELIVERY</t>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="border: 2px solid #000; padding: 1.5mm; text-align: center; font-size: 18px; font-weight: bold;">
                            <t t-if="o.ncm_cod_amount">COD NPR <t t-out="'{:,.2f}'.format(o.ncm_cod_amount).rstrip('0').rstrip('.')"/></t>
                            <t t-else="">PREPAID · NO CASH</t>
                        </td>
                    </tr>
                </table>
                <div style="margin-top: 2mm;">
                    <div style="font-size: 9px;">RECEIVER</div>
                    <div style="font-size: 13px; font-weight: bold;" t-out="partner.name or partner.parent_id.name or ''"/>
                    <div t-out="', '.join(p for p in o._ncm_phones() if p)"/>
                    <div t-out="o._ncm_address()"/>
                </div>
                <div style="margin-top: 2mm;">
                    <div style="font-size: 9px;">SENDER</div>
                    <div style="font-weight: bold;" t-out="o.company_id.name"/>
                    <div t-out="o.company_id.phone or ''"/>
                </div>
                <table style="width: 100%; margin-top: 2mm; border-top: 1px solid #000;">
                    <tr><td style="width: 26%;">Order ref</td><td t-out="o.ncm_vref or o.origin or o.name"/></tr>
                    <tr><td>Contents</td><td t-out="o.ncm_package_description or o._ncm_package_description()"/></tr>
                    <tr><td>Weight</td><td><t t-out="o.ncm_weight or o._ncm_weight_kg()"/> kg</td></tr>
                    <tr t-if="o.ncm_instruction"><td>Instruction</td><td t-out="o.ncm_instruction"/></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_ncm_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="delivery_ncm.report_ncm_label_document"/>
            </t>
        </t>
    </template>

</odoo>
