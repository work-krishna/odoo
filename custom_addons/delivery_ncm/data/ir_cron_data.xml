<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_ncm_sync_branches" model="ir.cron">
        <field name="name">NCM: update branches and areas</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._ncm_cron_sync_branches()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_ncm_sync_status" model="ir.cron">
        <field name="name">NCM: update order statuses</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._ncm_cron_sync_status()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_ncm_sync_comments" model="ir.cron">
        <field name="name">NCM: fetch order comments</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._ncm_cron_sync_comments()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_ncm_process_webhooks" model="ir.cron">
        <field name="name">NCM: process webhook calls</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._ncm_cron_process_webhooks()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>

</odoo>
