<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_ncm" model="ir.ui.view">
        <field name="name">product.template.form.ncm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="ncm_pickup_branch_id" options="{'no_create': True}" placeholder="Delivery method's default"/>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_ncm" model="ir.ui.view">
        <field name="name">stock.warehouse.form.ncm</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="ncm_pickup_branch_id" options="{'no_create': True}" placeholder="Delivery method's default"/>
            </field>
        </field>
    </record>

</odoo>
