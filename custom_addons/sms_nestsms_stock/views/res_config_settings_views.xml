<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms.nestsms.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_sms.res_config_settings_view_form_stock"/>
        <field name="arch" type="xml">
            <!-- Odoo IAP credits don't apply: these texts go through NestSMS. -->
            <xpath expr="//setting[@id='stock_text_confirmation']/widget[@service_name='sms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
