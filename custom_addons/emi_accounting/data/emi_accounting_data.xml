<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_emi_vendor_settlement" model="ir.sequence">
        <field name="name">EMI Retailer Settlement</field>
        <field name="code">emi.vendor.settlement</field>
        <field name="prefix">SETL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_emi_post_due_installments" model="ir.cron">
        <field name="name">EMI: post installments falling due</field>
        <field name="model_id" ref="model_emi_schedule_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_due_installments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_emi_refresh_overdue" model="ir.cron">
        <field name="name">EMI: refresh overdue installments</field>
        <field name="model_id" ref="model_emi_schedule_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_emi_vendor_settlements" model="ir.cron">
        <field name="name">EMI: draft retailer settlements</field>
        <field name="model_id" ref="model_emi_vendor_settlement"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_settlements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
