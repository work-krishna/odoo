<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_fonepay" model="payment.provider">
        <field name="name">Fonepay</field>
        <field name="code">fonepay</field>
        <field name="module_id" ref="base.module_payment_fonepay"/>
        <field name="image_128" type="base64" file="payment_fonepay/static/description/icon.png"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_fonepay')])]"/>
        <field name="pending_msg" type="html">
            <p>
                Open your mobile banking or wallet app that supports Fonepay and scan the QR code
                to complete the payment.
            </p>
        </field>
    </record>

</odoo>
