<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_fonepay" model="ir.ui.view">
        <field name="name">Fonepay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'fonepay'">
                    <field
                        name="fonepay_merchant_code"
                        string="Merchant Code"
                        required="code == 'fonepay' and state != 'disabled'"
                    />
                    <field
                        name="fonepay_username"
                        string="Username"
                        required="code == 'fonepay' and state != 'disabled'"
                    />
                    <field
                        name="fonepay_password"
                        string="Password"
                        required="code == 'fonepay' and state != 'disabled'"
                        password="True"
                    />
                    <field
                        name="fonepay_secret_key"
                        string="Secret Key"
                        required="code == 'fonepay' and state != 'disabled'"
                        password="True"
                    />
                </group>
            </group>
        </field>
    </record>

</odoo>
