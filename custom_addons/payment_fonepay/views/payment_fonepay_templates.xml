<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <!-- No external redirection happens: this form is submitted to our own controller to
             flip the transaction to 'pending' once the QR code has been generated, then the
             customer lands on the payment status page where the QR code is displayed. -->
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

    <!-- Retry/Cancel actions shown for a failed or canceled Fonepay payment. Factored out as its
         own callable template (rather than inlined in fonepay_state_header) so that other pages
         which don't reach payment.state_header at all, e.g. website_sale's own order
         confirmation page (see website_sale_payment_fonepay), can t-call the exact same markup
         instead of duplicating it.

         Expected context: `tx` (the failed/canceled payment.transaction) and, optionally:
         - `fonepay_cancel_url`: where "Cancel" should navigate to; defaults to tx.landing_route,
           which is a reasonable "go back to where this came from" for most flows, but callers
           that know a more specific destination, e.g. the shop cart, should set it explicitly.
         - `fonepay_retry_url`: if set, "Retry Payment" becomes a plain link to this URL instead
           of immediately regenerating a Fonepay QR code. Use this wherever a real "choose a
           payment method" page exists for the underlying document (e.g. website_sale's
           /shop/payment) so the customer can pick a different method too, not just Fonepay
           again. Left unset, the default behaviour applies: retrying goes straight back to a
           fresh Fonepay QR, which is the only sensible option where no such page exists (e.g. a
           generic payment link with no shop/portal page behind it). -->
    <template id="retry_cancel_actions">
        <div t-if="tx.provider_id.sudo().code == 'fonepay' and tx.state in ('cancel', 'error')"
             name="o_fonepay_retry_actions"
             class="mt-3 d-flex gap-2"
        >
            <a t-if="fonepay_retry_url" t-att-href="fonepay_retry_url" class="btn btn-primary">Retry Payment</a>
            <form t-else="" method="post" t-att-action="'/payment/fonepay/retry'">
                <input type="hidden" name="reference" t-att-value="tx.reference"/>
                <button type="submit" class="btn btn-primary">Retry Payment</button>
            </form>
            <a t-att-href="fonepay_cancel_url or tx.landing_route or '/'" class="btn btn-secondary">Cancel</a>
        </div>
    </template>

    <template id="fonepay_state_header" inherit_id="payment.state_header">
        <!-- Rendered as a sibling *after* the status alert, not inside it: that alert is a flex
             row (`d-flex gap-3`) for its icon + message, and appending the QR card inside it
             would squeeze it into that same row instead of showing below as its own block. -->
        <xpath expr="//div[@name='o_payment_status_alert']" position="after">
            <t t-set="fonepay_qr_code"
               t-value="tx.provider_id.sudo().code == 'fonepay' and tx.state == 'pending' and tx._fonepay_get_qr_code()"
            />
            <div t-if="fonepay_qr_code"
                 name="o_fonepay_qr_wrapper"
                 t-att-data-reference="tx.reference"
                 t-att-data-remaining="tx._fonepay_get_remaining_seconds() if tx.provider_id.sudo().fonepay_payment_timeout else None"
                 class="o_fonepay_qr_card card mt-3 mx-auto"
                 style="max-width: 320px;"
            >
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <img src="/payment_fonepay/static/description/icon.png" alt="Fonepay"
                         class="mb-2 rounded" style="height: 48px; width: auto;"
                    />
                    <p class="fw-bold mb-2">
                        Scan this QR code with your mobile banking or wallet app.
                    </p>
                    <img class="mb-2 border rounded"
                         style="max-width: 220px; width: 100%;"
                         t-att-src="fonepay_qr_code"
                         alt="Fonepay QR Code"
                    />
                    <div class="mb-2">
                        <strong>Amount: </strong>
                        <span t-esc="tx.amount"
                              t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"
                        />
                    </div>
                    <small class="text-muted lh-sm">
                        <i class="fa fa-spinner fa-spin me-1"/>
                        Waiting for payment confirmation...
                    </small>
                    <small name="o_fonepay_countdown" class="text-muted lh-sm">
                        <t t-if="tx.provider_id.sudo().fonepay_payment_timeout">
                            Expires in <span name="o_fonepay_countdown_value">-:--</span>
                        </t>
                    </small>
                </div>
            </div>

            <!-- Same reasoning as the QR card above: a sibling block after the status alert,
                 never nested inside its flex row. -->
            <t t-call="payment_fonepay.retry_cancel_actions"/>
        </xpath>
    </template>

</odoo>
