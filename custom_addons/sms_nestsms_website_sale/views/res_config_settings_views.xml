<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms_nestsms_website_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sms_nestsms.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="sms_nestsms_otp" position="inside">
                <div class="mt-2">
                    <field name="sms_otp_checkout" class="w-auto"/>
                    <label for="sms_otp_checkout" string="Require a confirmed mobile number to order" class="o_light_label"/>
                    <field name="sms_otp_checkout_approved" invisible="1"/>
                    <div class="ms-4 small text-muted" invisible="not sms_otp_checkout">
                        Strict: no order goes through until the buyer has proven their own number (once; a number
                        proven at sign-up counts). Delivery addresses may carry any number.
                    </div>
                    <div class="ms-4 mt-1" invisible="not sms_otp_checkout">
                        <div class="d-flex align-items-baseline gap-2">
                            <label for="sms_otp_checkout_template" string="Template" class="o_light_label text-nowrap"/>
                            <field name="sms_otp_checkout_template" class="flex-grow-1 small" placeholder="Choose, or paste the ID"/>
                        </div>
                        <div>
                            <button name="action_sms_otp_choose_template" type="object" string="Choose…" icon="oi-arrow-right"
                                    class="btn-link p-0 me-3" context="{'sms_otp_purpose': 'checkout'}"/>
                            <button name="action_sms_otp_check_template" type="object" string="Check" icon="oi-arrow-right"
                                    class="btn-link p-0" context="{'sms_otp_purpose': 'checkout'}"/>
                        </div>
                        <div class="small">
                            <span class="text-success" invisible="not sms_otp_checkout_approved">Approved by NestSMS: codes are on.</span>
                            <span class="text-danger fw-bold" invisible="sms_otp_checkout_approved">
                                Checkout is held for shoppers without a proven number until you choose an approved template.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
