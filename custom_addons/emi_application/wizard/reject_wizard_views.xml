<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emi_application_reject_wizard_form" model="ir.ui.view">
        <field name="name">emi.application.reject.wizard.form</field>
        <field name="model">emi.application.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="application_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this application being rejected? The customer will be told."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
