<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emi_application_form" model="ir.ui.view">
        <field name="name">emi.application.form</field>
        <field name="model">emi.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'" class="btn-primary"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_start_review" type="object" string="Start KYC Review"
                            invisible="state != 'submitted'" class="btn-primary"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_verify_kyc" type="object" string="Verify KYC"
                            invisible="state != 'kyc_review' or kyc_verified" class="btn-primary"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_send_to_finance" type="object" string="Send to Finance Company"
                            invisible="state != 'kyc_review' or not kyc_verified" class="btn-primary"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_return_to_draft" type="object" string="Return to Draft"
                            invisible="state not in ('submitted', 'kyc_review')"
                            groups="emi_finance.group_emi_officer"
                            confirm="Send this application back to draft for corrections? KYC verification will be cleared."/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'pending_finance_approval'" class="btn-primary"
                            groups="emi_finance.group_emi_finance_reviewer"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'kyc_review'"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'pending_finance_approval'"
                            groups="emi_finance.group_emi_finance_reviewer"/>
                    <button name="action_disburse" type="object" string="Disburse"
                            invisible="state != 'approved'" class="btn-primary"
                            groups="emi_finance.group_emi_finance_reviewer"/>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'disbursed'" class="btn-primary"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'active'"
                            groups="emi_finance.group_emi_officer"/>
                    <button name="action_mark_default" type="object" string="Mark Defaulted"
                            invisible="state != 'active'"
                            groups="emi_finance.group_emi_officer"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,kyc_review,pending_finance_approval,approved,disbursed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="vendor_id"/>
                            <field name="list_price"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_tmpl_id_domain" invisible="1"/>
                            <field name="allowed_tenure_plan_ids" invisible="1"/>
                        </group>
                        <group>
                            <field name="finance_company_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="tenure_plan_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="interest_rate_id" invisible="1"/>
                            <field name="interest_rate_percent"/>
                            <field name="interest_calc_method"/>
                        </group>
                    </group>
                    <group>
                        <group string="Down Payment">
                            <field name="downpayment_option_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="min_down_payment_amount"/>
                            <field name="down_payment_amount" readonly="state != 'draft'"/>
                        </group>
                        <group string="EMI Preview">
                            <field name="tenure_months"/>
                            <field name="financed_amount"/>
                            <field name="total_interest_amount"/>
                            <field name="total_payable_amount"/>
                            <field name="emi_amount"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <field name="delivery_address_id" readonly="state != 'draft'"
                               context="{'default_type': 'delivery', 'default_parent_id': partner_id}"/>
                        <field name="delivery_note" readonly="state != 'draft'"/>
                    </group>
                    <group string="Review" invisible="state == 'draft'">
                        <group>
                            <field name="kyc_verified"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_date"/>
                        </group>
                        <group>
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                            <field name="rejection_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KYC" name="kyc">
                            <!-- Not editable inline: rows open the full KYC form
                                 (all required fields and document uploads). -->
                            <field name="kyc_ids" readonly="state not in ('draft', 'submitted', 'kyc_review')">
                                <list>
                                    <field name="full_name"/>
                                    <field name="phone"/>
                                    <field name="citizenship_no"/>
                                    <field name="verified"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_emi_application_list" model="ir.ui.view">
        <field name="name">emi.application.list</field>
        <field name="model">emi.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="finance_company_id"/>
                <field name="tenure_plan_id"/>
                <field name="emi_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved', 'active')"
                       decoration-warning="state in ('submitted', 'kyc_review', 'pending_finance_approval')"
                       decoration-danger="state in ('rejected', 'defaulted')"
                       decoration-info="state in ('disbursed', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_emi_application_search" model="ir.ui.view">
        <field name="name">emi.application.search</field>
        <field name="model">emi.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="finance_company_id"/>
                <filter string="Needs KYC Review" name="needs_kyc" domain="[('state', '=', 'submitted')]"/>
                <filter string="Pending Finance Approval" name="pending_finance"
                        domain="[('state', '=', 'pending_finance_approval')]"/>
                <filter string="Active" name="active_loans" domain="[('state', '=', 'active')]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Finance Company" name="group_finance"
                            context="{'group_by': 'finance_company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_emi_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">emi.application</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_kyc': 0}</field>
    </record>

</odoo>
