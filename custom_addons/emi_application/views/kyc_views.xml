<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emi_kyc_form" model="ir.ui.view">
        <field name="name">emi.kyc.form</field>
        <field name="model">emi.kyc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Personal">
                            <field name="full_name"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Identity">
                            <field name="citizenship_no"/>
                            <field name="citizenship_issue_district"/>
                            <field name="citizenship_issue_date"/>
                            <field name="pan_no"/>
                            <field name="verified"/>
                            <field name="consent_date" invisible="not consent_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="permanent_address"/>
                            <field name="temporary_address"/>
                        </group>
                        <group string="Income">
                            <field name="occupation"/>
                            <field name="employer_name"/>
                            <field name="monthly_income"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Bank">
                        <field name="bank_name"/>
                        <field name="bank_account_no"/>
                    </group>
                    <group string="Applicant Documents">
                        <field name="citizenship_front" filename="citizenship_front_filename"/>
                        <field name="citizenship_front_filename" invisible="1"/>
                        <field name="citizenship_back" filename="citizenship_back_filename"/>
                        <field name="citizenship_back_filename" invisible="1"/>
                        <field name="photo" filename="photo_filename"/>
                        <field name="photo_filename" invisible="1"/>
                        <field name="income_proof" filename="income_proof_filename"/>
                        <field name="income_proof_filename" invisible="1"/>
                        <field name="nid_front" string="NID Front (optional)" filename="nid_front_filename"/>
                        <field name="nid_front_filename" invisible="1"/>
                        <field name="nid_back" string="NID Back (optional)" filename="nid_back_filename"/>
                        <field name="nid_back_filename" invisible="1"/>
                    </group>
                    <group>
                        <group string="Guarantor">
                            <field name="guarantor_name" string="Name"/>
                            <field name="guarantor_phone" string="Phone"/>
                            <field name="guarantor_relation" string="Relation"/>
                        </group>
                        <group string="Guarantor Documents">
                            <field name="guarantor_citizenship_front" string="Citizenship Front"
                                   filename="guarantor_citizenship_front_filename"/>
                            <field name="guarantor_citizenship_front_filename" invisible="1"/>
                            <field name="guarantor_citizenship_back" string="Citizenship Back"
                                   filename="guarantor_citizenship_back_filename"/>
                            <field name="guarantor_citizenship_back_filename" invisible="1"/>
                            <field name="guarantor_nid_front" string="NID Front (optional)"
                                   filename="guarantor_nid_front_filename"/>
                            <field name="guarantor_nid_front_filename" invisible="1"/>
                            <field name="guarantor_nid_back" string="NID Back (optional)"
                                   filename="guarantor_nid_back_filename"/>
                            <field name="guarantor_nid_back_filename" invisible="1"/>
                            <field name="guarantor_photo" string="Passport-size Photo"
                                   filename="guarantor_photo_filename"/>
                            <field name="guarantor_photo_filename" invisible="1"/>
                        </group>
                    </group>
                    <!-- Items an EMI Manager configured under Applications > KYC Requirements;
                         each row opens a small form to upload or enter it. -->
                    <group string="Additional Items" invisible="not item_ids">
                        <field name="item_ids" nolabel="1" colspan="2">
                            <list create="0" delete="0">
                                <field name="party"/>
                                <field name="name"/>
                                <field name="required"/>
                                <field name="value_display"/>
                            </list>
                        </field>
                    </group>
                    <div class="text-end" groups="emi_finance.group_emi_manager">
                        <button name="%(action_emi_kyc_requirement)d" type="action" icon="fa-cog"
                                string="Configure additional KYC items" class="btn-link"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_emi_kyc_item_form" model="ir.ui.view">
        <field name="name">emi.kyc.item.form</field>
        <field name="model">emi.kyc.item</field>
        <field name="arch" type="xml">
            <form string="KYC Item">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <field name="description" readonly="1" invisible="not description" class="text-muted"/>
                    <group>
                        <field name="value_type" invisible="1"/>
                        <field name="required" invisible="1"/>
                        <field name="template" filename="template_filename" readonly="1" invisible="not template"/>
                        <field name="template_filename" invisible="1"/>
                        <field name="value_file" filename="value_filename" invisible="value_type != 'file'"/>
                        <field name="value_filename" invisible="1"/>
                        <field name="value_text" invisible="value_type not in ('text', 'number')"/>
                        <field name="value_date" invisible="value_type != 'date'"/>
                        <field name="value_bool" invisible="value_type != 'checkbox'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_emi_kyc_search" model="ir.ui.view">
        <field name="name">emi.kyc.search</field>
        <field name="model">emi.kyc</field>
        <field name="arch" type="xml">
            <search>
                <field name="full_name"/>
                <field name="partner_id"/>
                <field name="citizenship_no"/>
                <field name="phone"/>
                <filter string="Not Verified" name="not_verified" domain="[('verified', '=', False)]"/>
                <filter string="Verified" name="verified" domain="[('verified', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_emi_kyc" model="ir.actions.act_window">
        <field name="name">KYC Records</field>
        <field name="res_model">emi.kyc</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_emi_kyc_list" model="ir.ui.view">
        <field name="name">emi.kyc.list</field>
        <field name="model">emi.kyc</field>
        <field name="arch" type="xml">
            <list>
                <field name="full_name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="citizenship_no"/>
                <field name="application_id"/>
                <field name="verified"/>
            </list>
        </field>
    </record>

</odoo>
