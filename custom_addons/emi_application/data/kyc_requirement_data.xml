<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Seeded as a configurable item, so the blank form, wording and whether it
         is required can be changed under Applications > KYC Requirements. -->
    <record id="kyc_requirement_signed_agreement" model="emi.kyc.requirement">
        <field name="name">Signed EMI Application / Agreement Form</field>
        <field name="party">applicant</field>
        <field name="value_type">file</field>
        <field name="required" eval="True"/>
        <field name="sequence">10</field>
        <field name="description">The EMI application / agreement form, signed by both the applicant and the guarantor (scan or photo).</field>
    </record>

</odoo>
