<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_khalti" model="ir.ui.view">
        <field name="name">Khalti Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'khalti'">
                    <field name="khalti_secret_key" string="Secret Key" password="True"
                           required="code == 'khalti' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
