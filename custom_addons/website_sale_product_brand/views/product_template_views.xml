<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.website_sale_product_brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_brand.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="product_brand_id" position="after">
                <field name="website_show_brand" invisible="not sale_ok"/>
            </field>
        </field>
    </record>
</odoo>
