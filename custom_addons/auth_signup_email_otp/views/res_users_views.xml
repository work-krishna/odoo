<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.signup.email.otp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_signup_send_verification" type="object" string="Send Activation Email"
                        invisible="signup_email_verified"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div invisible="signup_email_verified" class="text-warning">
                    <field name="signup_email_verified" widget="boolean_toggle" class="oe_inline"/>
                    <span>Not activated yet: this person signed up on the website and has not entered the emailed code.</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
