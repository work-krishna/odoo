<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Forgotten password, step 1: who, and how to send the code. -->
    <template id="reset_password_ask" name="Reset Password: Send a Code">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/web/reset_password" data-captcha="password_reset">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-2">Reset your password</h4>
                <p class="text-muted">We send you a code to make sure it's you.</p>
                <p class="alert alert-danger" t-if="error" role="alert" t-out="error"/>
                <div class="mb-3">
                    <label for="login" class="form-label">
                        <t t-if="sms_available">Email or verified mobile number</t>
                        <t t-else="">Email</t>
                    </label>
                    <input type="text" name="login" id="login" t-att-value="login" class="form-control"
                           required="required" autofocus="autofocus" autocapitalize="off" autocomplete="username"/>
                </div>
                <fieldset t-if="sms_available" class="mb-3" id="reset_method">
                    <legend class="form-label fs-6 mb-1">Send the code by</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="method" id="reset_method_email" value="email"
                               t-att-checked="method != 'sms' and 'checked'"/>
                        <label class="form-check-label" for="reset_method_email">Email</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="method" id="reset_method_sms" value="sms"
                               t-att-checked="method == 'sms' and 'checked'"/>
                        <label class="form-check-label" for="reset_method_sms">
                            SMS to my verified mobile number
                            <span class="d-block small text-muted">We also email you a different code: enter either one.</span>
                        </label>
                    </div>
                </fieldset>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Send code</button>
                </div>
                <div class="small mt-3">
                    <a href="/web/login">Back to Login</a>
                </div>
            </form>
        </t>
    </template>

    <!-- Step 2: the code (from the email or the SMS). -->
    <template id="reset_password_code" name="Reset Password: Enter the Code">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/web/reset_password/code">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-3">Enter your code</h4>
                <p id="reset_code_intro">
                    <t t-if="method == 'sms'">
                        If <strong t-out="login"/> matches an account, we emailed it a 6-digit code and, if it has a
                        verified mobile number, texted a different one to that number. Enter either code.
                    </t>
                    <t t-else="">
                        If <strong t-out="login"/> matches an account, we emailed it a 6-digit code.
                    </t>
                    It expires <t t-out="validity"/> minutes after we send it.
                </p>
                <p class="alert alert-danger" t-if="error" role="alert" t-out="error"/>
                <div class="mb-3">
                    <label for="reset_code" class="form-label">
                        <t t-if="method == 'sms'">Code from the SMS or the email</t>
                        <t t-else="">Code from the email</t>
                    </label>
                    <input type="text" name="code" id="reset_code" class="form-control form-control-lg text-center"
                           required="required" autofocus="autofocus" autocomplete="one-time-code"
                           inputmode="numeric" maxlength="7" placeholder="000000"/>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Continue</button>
                </div>
            </form>
            <form method="post" action="/web/reset_password" data-captcha="password_reset" class="text-center mt-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="login" t-att-value="login"/>
                <input type="hidden" name="method" t-att-value="method"/>
                <button type="submit" class="btn btn-link" id="reset_code_resend">Send me a new code</button>
            </form>
            <p class="text-center small mb-0">
                <a href="/web/reset_password">Use another email or method</a>
            </p>
        </t>
    </template>

    <!-- Step 3: the new password. -->
    <template id="reset_password_new" name="Reset Password: Choose a New Password">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/web/reset_password/new">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-2">Choose a new password</h4>
                <p class="text-muted">For <strong t-out="login"/>.</p>
                <p class="alert alert-danger" t-if="error" role="alert" t-out="error"/>
                <div class="mb-3">
                    <label for="password" class="form-label">New password</label>
                    <input type="password" name="password" id="password" class="form-control"
                           required="required" autofocus="autofocus" autocomplete="new-password"/>
                </div>
                <div class="mb-3">
                    <label for="confirm_password" class="form-label">Confirm new password</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control"
                           required="required" autocomplete="new-password"/>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Save password</button>
                </div>
            </form>
        </t>
    </template>

</odoo>
