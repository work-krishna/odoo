<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emi_phone_brand_list" model="ir.ui.view">
        <field name="name">emi.phone.brand.list</field>
        <field name="model">emi.phone.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="logo" widget="image" options="{'size': [32, 32]}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_emi_phone_brand" model="ir.actions.act_window">
        <field name="name">Phone Brands</field>
        <field name="res_model">emi.phone.brand</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
