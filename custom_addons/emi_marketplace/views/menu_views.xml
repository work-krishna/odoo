<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reuses the "EMI Platform" root menu defined in emi_finance
         (declared as a dependency in __manifest__.py). The root carries no
         groups, so it shows for anyone who can see one of these entries. -->
    <menuitem id="menu_emi_marketplace_root" name="Marketplace"
              parent="emi_finance.menu_emi_root" sequence="20"/>

    <menuitem id="menu_emi_vendor" name="Vendors"
              parent="menu_emi_marketplace_root" action="action_emi_vendor"
              groups="emi_marketplace.group_emi_marketplace_admin,emi_finance.group_emi_officer"
              sequence="10"/>

    <menuitem id="menu_emi_listing_review" name="Listings to Review"
              parent="menu_emi_marketplace_root" action="action_emi_listing_review"
              groups="emi_marketplace.group_emi_marketplace_admin" sequence="20"/>

    <menuitem id="menu_emi_listing_all" name="Vendor Listings"
              parent="menu_emi_marketplace_root" action="action_emi_listing_all"
              groups="emi_marketplace.group_emi_marketplace_admin" sequence="30"/>

</odoo>
