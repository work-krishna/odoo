<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sms_nestsms_otp_view_list" model="ir.ui.view">
        <field name="name">sms.nestsms.otp.view.list</field>
        <field name="model">sms.nestsms.otp</field>
        <field name="arch" type="xml">
            <list string="SMS One-Time Codes" create="0" edit="0" delete="0">
                <field name="create_date" string="Sent"/>
                <field name="purpose"/>
                <field name="number"/>
                <field name="state" decoration-success="state == 'verified'" decoration-danger="state in ('blocked', 'failed')"/>
                <field name="attempts"/>
                <field name="ip_address" optional="hide"/>
                <field name="failure_reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sms_nestsms_otp_view_search" model="ir.ui.view">
        <field name="name">sms.nestsms.otp.view.search</field>
        <field name="model">sms.nestsms.otp</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <filter name="failed" string="Not Sent" domain="[('state', '=', 'failed')]"/>
                <filter name="blocked" string="Too Many Wrong Codes" domain="[('state', '=', 'blocked')]"/>
                <group>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sms_nestsms_otp_action" model="ir.actions.act_window">
        <field name="name">SMS One-Time Codes</field>
        <field name="res_model">sms.nestsms.otp</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No code texted yet</p>
            <p>Codes for login, sign-up, checkout and EMI applications appear here. The codes themselves are never stored, only a keyed hash.</p>
        </field>
    </record>

    <menuitem id="sms_nestsms_otp_menu" action="sms_nestsms_otp_action"
              parent="phone_validation.phone_menu_main" sequence="20" groups="base.group_system"/>
</odoo>
