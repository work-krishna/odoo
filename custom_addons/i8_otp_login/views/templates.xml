<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="otp_login_template" name="OTP Login Snippet">
        <div id="otp-login-form" t-att-data-redirect="redirect"
             class="p-3 p-md-4 border rounded bg-white text-center mx-auto"
             style="max-width: 100%;  border-color: #eee !important;">

            <!-- Step 1: Email Row -->
            <div id="email-step" class="text-start">
                <label for="otp-email" class="fw-bold mb-2 text-dark">Email
                    <span class="text-danger">*</span>
                </label>

                <!-- Desktop: Inline (flex-sm-row) | Mobile: Stacked (flex-column) -->
                <div class="d-flex flex-column flex-sm-row gap-2 mb-3 w-100">
                    <input type="email" id="otp-email" name="email"
                           class="form-control form-control-lg fs-6 shadow-none w-100"
                           placeholder="Enter your email"
                           style="border-radius: 8px; flex-grow: 1; border: 1px solid #ccc;"/>

                    <button type="button" id="btn-send-otp"
                            class="btn btn-primary btn-lg fw-bold px-4 w-100 w-sm-auto"
                            style="border-radius: 8px; white-space: nowrap; transition: all 0.3s;">
                        Verify
                    </button>
                </div>
                <div id="otp-email-msg" class="text-danger small mb-2"></div>
            </div>

            <!-- Step 2: OTP Entry -->
            <div id="otp-step" class="d-none">
                <h5 class="mb-3 fw-bold" style="color: #444;">Enter OTP</h5>
                <div class="d-flex justify-content-center gap-2 mb-4">
                    <t t-foreach="range(6)" t-as="i">
                        <input type="text" inputmode="numeric" maxlength="1"
                               class="otp-digit form-control text-center fw-bold border-2"
                               style="width: 45px; height: 50px; font-size: 1.3rem; border-radius: 8px; border: 2px solid #ddd;"/>
                    </t>
                </div>

                <button id="btn-verify-otp" class="btn btn-success btn-lg w-100 mb-3 fw-bold shadow-sm"
                        style="border-radius: 8px; height: 50px;">
                    Verify OTP
                </button>

                <div class="mt-2 small text-muted">
                    <span id="resend-timer-text">
                        Resend code in <b id="otp-timer" class="text-primary">60</b>s
                    </span>
                    <a href="#" id="btn-resend-otp" class="d-none text-primary fw-bold text-decoration-none">
                        <i class="fa fa-refresh me-1"/>
                        Resend OTP
                    </a>
                </div>
            </div>

            <div id="otp-success" class="alert alert-success d-none mt-3 border-0">
                Success! Redirecting...
            </div>
        </div>
    </template>
</odoo>