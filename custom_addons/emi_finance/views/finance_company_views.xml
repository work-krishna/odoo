<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emi_finance_company_form" model="ir.ui.view">
        <field name="name">emi.finance.company.form</field>
        <field name="model">emi.finance.company</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_interest_rates" type="object"
                                class="oe_stat_button" icon="fa-percent">
                            <field name="interest_rate_count" widget="statinfo" string="Interest Rates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="contact_person"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Financing Defaults">
                        <field name="min_down_payment_percent"/>
                        <field name="tenure_plan_ids" widget="many2many_tags"/>
                        <field name="settlement_bank_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_emi_finance_company_list" model="ir.ui.view">
        <field name="name">emi.finance.company.list</field>
        <field name="model">emi.finance.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="contact_person"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="action_emi_finance_company" model="ir.actions.act_window">
        <field name="name">Finance Companies</field>
        <field name="res_model">emi.finance.company</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
