<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- No groups on the root or folder menus: a folder is shown whenever one
         of its children is visible, so each role sees only its own branches
         (including Marketplace, added under this root by emi_marketplace). -->
    <menuitem id="menu_emi_root" name="EMI Platform" sequence="50"/>
    <!-- <menuitem> only ever links groups, so databases that installed the
         earlier version (root limited to officer/reviewer) need an explicit clear. -->
    <record id="menu_emi_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.clear()]"/>
    </record>

    <menuitem id="menu_emi_finance_root" name="Finance" parent="menu_emi_root" sequence="10"/>

    <menuitem id="menu_emi_finance_company" name="Finance Companies"
              parent="menu_emi_finance_root" action="action_emi_finance_company"
              groups="group_emi_officer,group_emi_finance_reviewer" sequence="10"/>

    <menuitem id="menu_emi_interest_rate" name="Interest Rates"
              parent="menu_emi_finance_root" action="action_emi_interest_rate"
              groups="group_emi_officer,group_emi_finance_reviewer" sequence="20"/>

    <menuitem id="menu_emi_tenure_plan" name="Tenure Plans"
              parent="menu_emi_finance_root" action="action_emi_tenure_plan"
              groups="group_emi_officer" sequence="30"/>

    <menuitem id="menu_emi_downpayment_option" name="Down Payment Options"
              parent="menu_emi_finance_root" action="action_emi_downpayment_option"
              groups="group_emi_officer" sequence="40"/>

</odoo>
