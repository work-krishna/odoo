<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_emi_platform" model="ir.module.category">
        <field name="name">EMI Platform</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: res.groups.category_id was removed in favour of privilege_id,
         a many2one to res.groups.privilege (which itself carries category_id). -->
    <record id="privilege_emi_platform" model="res.groups.privilege">
        <field name="name">EMI Platform</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_emi_platform"/>
    </record>

    <!-- Marketplace-side staff who manage finance company configuration -->
    <record id="group_emi_officer" model="res.groups">
        <field name="name">EMI Officer</field>
        <field name="privilege_id" ref="privilege_emi_platform"/>
        <field name="comment">Marketplace staff: manage finance companies, tenure plans and interest rates.</field>
    </record>

    <record id="group_emi_manager" model="res.groups">
        <field name="name">EMI Manager</field>
        <field name="privilege_id" ref="privilege_emi_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_emi_officer'))]"/>
        <field name="comment">Full administrative access to EMI Platform configuration.</field>
    </record>

    <!-- Finance company staff: internal users, scoped to their own company -->
    <record id="group_emi_finance_reviewer" model="res.groups">
        <field name="name">Finance Company Reviewer</field>
        <field name="privilege_id" ref="privilege_emi_platform"/>
        <field name="comment">Finance company staff with direct Odoo access, restricted to their own finance company's records.</field>
    </record>

    <!-- Finance company reviewers only see their own finance company record -->
    <record id="rule_finance_company_own_company" model="ir.rule">
        <field name="name">Finance Company Reviewer: own company only</field>
        <field name="model_id" ref="model_emi_finance_company"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_emi_finance_reviewer'))]"/>
    </record>

    <record id="rule_interest_rate_own_company" model="ir.rule">
        <field name="name">Finance Company Reviewer: own interest rates only</field>
        <field name="model_id" ref="model_emi_interest_rate"/>
        <field name="domain_force">[('finance_company_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_emi_finance_reviewer'))]"/>
    </record>

</odoo>
