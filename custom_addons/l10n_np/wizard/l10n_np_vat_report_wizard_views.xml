<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_np_vat_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n.np.vat.report.wizard.form</field>
        <field name="model">l10n.np.vat.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Nepal VAT Report">
                <p class="text-muted">
                    This report is an internal reconciliation aid to help prepare an IRD VAT
                    filing. It is not an official or certified IRD form.
                </p>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="vat_sale_tax_ids" widget="many2many_tags"/>
                        <field name="vat_purchase_tax_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="tax_type"/>
                        <field name="tax_id"/>
                        <field name="base_amount"/>
                        <field name="tax_amount"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="total_output_vat"/>
                    <field name="total_input_vat"/>
                    <field name="net_amount"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_np_vat_report_wizard" model="ir.actions.act_window">
        <field name="name">Nepal VAT Report</field>
        <field name="res_model">l10n.np.vat.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_np_vat_report"
        name="Nepal VAT Report"
        parent="account.account_reports_legal_statements_menu"
        action="action_l10n_np_vat_report_wizard"
        groups="account.group_account_readonly"
        sequence="10"/>

</odoo>
