<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_esewa" model="payment.provider">
        <field name="name">eSewa</field>
        <field name="code">esewa</field>
        <field name="module_id" ref="base.module_payment_esewa"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_esewa')])]"/>
        <!-- No credentials: eSewa's public UAT merchant (EPAYTEST) is entered by hand for testing. -->
    </record>

</odoo>
